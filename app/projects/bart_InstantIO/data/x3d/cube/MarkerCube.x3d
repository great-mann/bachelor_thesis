<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 3.0//EN" "http://www.web3d.org/specifications/x3d-3.0.dtd">
<X3D xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' profile='Full' version='3.0' xsd:noNamespaceSchemaLocation='http://www.web3d.org/specifications/x3d-3.0.xsd'> 
    
    
    <ProtoDeclare name='MarkerCube'>
        <ProtoInterface>
            <field accessType='inputOutput' name='ids'  type='MFInt32' value='1 2 3 4 5 6'   description='Marker ids in [1,1023]'/>
            <field accessType='inputOutput' name='markerSize' type='SFFloat' value='0.05566' description='Marker size in m - Default 0.05566'/>
            <field accessType='inputOutput' name='cubeSize' type='SFFloat' value='0.071' description='Cube size in m (one edge) - Default 0.071'/>
            <field accessType='inputOnly' name='matrix' type='SFMatrix4f'  description='Matrix of the cube'/>
        </ProtoInterface>
    
        <ProtoBody>
            <ExternProtoDeclare name='FiducialMarker' url='../FiducialMarker.x3d'/>    
        
            <MatrixTransform DEF='cubeBase' invert='false'> <!-- Transformation of the cube -->
                <IS>
                    <connect nodeField='matrix' protoField='matrix'/>
                </IS>
                <Transform DEF='t_axis' scale='0.03 0.03 0.03'>
                    <Inline url='axis.x3d'/>
                </Transform>
                <Transform DEF='innerTrans' scale='0.0709 0.0709 0.0709'>
                    <Shape>
                        <Box DEF='innerBox' size='1 1 1'/>
                        <Material diffuseColor='1 1 0'/>
                    </Shape>
                </Transform>
                
                <!-- All the markers -->
                <Transform DEF='t_1' translation='1 0 0' rotation='0 1 0 1.57'>
                    <Transform DEF='t_1_1' translation='0 0 0' rotation='1 0 0 1.57'>
                        <GlobalTransformSensor DEF='gts_1'/>
                        <MatrixDecomposer DEF='dec_1'/>                    
                        <ROUTE fromNode='gts_1' fromField='transformation_changed' toNode='dec_1' toField='set_matrix' />
                        <FiducialMarker DEF='marker_1' id='1' size='0.05' />
                    </Transform>
                </Transform>
                <Transform DEF='t_2' translation='0 0 -1' rotation='0 1 0 3.141'>
                    <Transform DEF='t_2_1' translation='0 0 0' rotation='1 0 0 1.57'>
                        <GlobalTransformSensor DEF='gts_2'/>
                        <MatrixDecomposer DEF='dec_2'/>                    
                        <ROUTE fromNode='gts_2' fromField='transformation_changed' toNode='dec_2' toField='set_matrix' />
                        <FiducialMarker DEF='marker_2' id='2' size='0.05' />
                    </Transform>
                </Transform>
                <Transform DEF='t_3' translation='-1 0 0' rotation='0 1 0 -1.57'>
                    <Transform DEF='t_3_1' translation='0 0 0' rotation='1 0 0 1.57'>
                        <GlobalTransformSensor DEF='gts_3'/>
                        <MatrixDecomposer DEF='dec_3'/>                    
                        <ROUTE fromNode='gts_3' fromField='transformation_changed' toNode='dec_3' toField='set_matrix' />
                        <FiducialMarker DEF='marker_3' id='3' size='0.05' />
                    </Transform>
                </Transform>
                <Transform DEF='t_4' translation='0 0 1' rotation='1 0 0 1.57'>
                    <FiducialMarker DEF='marker_4' id='4' size='0.05' />
                </Transform>
                <Transform DEF='t_5' translation='0 1 0' rotation='0 1 0 1.57'><!--type1(cube0,1,2):0 1 0 1.57  type2(cube3):0 1 0 3.14  type3(cube4,5): 0 -->
                    <FiducialMarker DEF='marker_5' id='5' size='0.05' />
                </Transform>
                <Transform DEF='t_6' translation='0 -1 0' rotation='0 1 0 1.57'><!--type1(cube0,1,2):0 1 0 1.57  type2(cube3): 0 1 0 3.14  type3(cube4,5): 1 0 0 3.14 -->
                    <Transform DEF='t_6_1' translation='0 0 0' rotation='0 0 1 3.141'> <!--type1(cube0,1,2) and type2(cube3): 0 0 1 3.14  type3(cube4,5): 0 1 0 3.141-->
                        <GlobalTransformSensor DEF='gts_6'/>
                        <MatrixDecomposer DEF='dec_6'/>                    
                        <ROUTE fromNode='gts_6' fromField='transformation_changed' toNode='dec_6' toField='set_matrix' />
                        <FiducialMarker DEF='marker_6' id='6' size='0.05' />
                    </Transform>
                </Transform>
            </MatrixTransform>
            
            <!-- Build the cube -->
            <Script DEF='buildCube' mustEvaluate="true" directOutput="true">
                <field accessType='initializeOnly' name='innerTrans'   type='SFNode' >
                    <Transform USE='innerTrans'/>
                </field>
                <field accessType='initializeOnly' name='marker1'   type='SFNode' >
                    <FiducialMarker USE='marker_1'/>
                </field>
                <field accessType='initializeOnly' name='marker2'   type='SFNode' >
                    <FiducialMarker USE='marker_2'/>
                </field>
                <field accessType='initializeOnly' name='marker3'   type='SFNode' >
                    <FiducialMarker USE='marker_3'/>
                </field>
                <field accessType='initializeOnly' name='marker4'   type='SFNode' >
                    <FiducialMarker USE='marker_4'/>
                </field>
                <field accessType='initializeOnly' name='marker5'   type='SFNode' >
                    <FiducialMarker USE='marker_5'/>
                </field>
                <field accessType='initializeOnly' name='marker6'   type='SFNode' >
                    <FiducialMarker USE='marker_6'/>
                </field>
                <field accessType='initializeOnly' name='t1'   type='SFNode' >
                    <Transform USE='t_1'/>
                </field>
                <field accessType='initializeOnly' name='t2'   type='SFNode' >
                    <Transform USE='t_2'/>
                </field>
                <field accessType='initializeOnly' name='t3'   type='SFNode' >
                    <Transform USE='t_3'/>
                </field>
                <field accessType='initializeOnly' name='t4'   type='SFNode' >
                    <Transform USE='t_4'/>
                </field>
                <field accessType='initializeOnly' name='t5'   type='SFNode' >
                    <Transform USE='t_5'/>
                </field>
                <field accessType='initializeOnly' name='t6'   type='SFNode' >
                    <Transform USE='t_6'/>
                </field>
                <field accessType='inputOutput' name='markerSize'   type='SFFloat' />
                <field accessType='inputOutput' name='cubeSize'   type='SFFloat' />
                <field accessType='inputOutput' name='ids'   type='MFInt32' />
                <IS>
                    <connect nodeField='markerSize' protoField='markerSize'/>
                    <connect nodeField='cubeSize' protoField='cubeSize'/>
                    <connect nodeField='ids' protoField='ids'/>
                </IS>
          
                <![CDATA[javascript:
  
  					function initialize() { 
                        markers = new Array(marker1, marker2, marker3, marker4, marker5, marker6);
                        transforms = new Array(t1, t2, t3, t4, t5, t6);
                        buildCube();
                    }
                    
                    function eventsProcessed() {
                        buildCube();
                    }
                    
                    function buildCube() {
                        // Set inner cube size
                        innerTrans.scale = new SFVec3f(1,1,1);
                        innerTrans.scale = innerTrans.scale.multiply(cubeSize).add(new SFVec3f(-0.0001,-0.0001,-0.0001));
                    
                        // Set markers and transformations
                        for (var i = 0; i < 6; ++i) {
                            markers[i].id = ids[i];
                            markers[i].size = markerSize;
                            transforms[i].translation = transforms[i].translation.multiply(cubeSize*0.5);
                        }
                    }
                    
                ]]>
            </Script>

        </ProtoBody>
    </ProtoDeclare>
</X3D>

