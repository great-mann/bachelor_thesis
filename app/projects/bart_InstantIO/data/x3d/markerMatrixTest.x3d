<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 3.0//EN" "http://www.web3d.org/specifications/x3d-3.0.dtd">
<X3D xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' profile='Full' version='3.0' xsd:noNamespaceSchemaLocation='http://www.web3d.org/specifications/x3d-3.0.xsd'> 
    
    <Engine>
    <RenderJob>
      <WindowGroup DEF='defaultWindowGroup'>
        <LocalWindow DEF='defaultWindow' size='1280.0 720.0' position='200 200'/> 
      </WindowGroup>
    </RenderJob>
  </Engine>
    
    
    <Scene DEF='scene'>
    
        <!-- Webcam IOSensor -->
        <!--IOSensor DEF='video' type='Video' Device='0' Width='640' Height='480' Format='YUY2' >
          <field accessType='outputOnly' name='frames' type='SFImage'/>  
        </IOSensor-->
        <!--IOSensor DEF='video' type='irioBGRCamera' device='0' >
          <field accessType='outputOnly'  name='frames' type='SFImage'/>  
          <field accessType='inputOutput' name='width'  type='SFInt32' value='640'/>  
          <field accessType='inputOutput' name='height' type='SFInt32' value='480'/>  
          <field accessType='inputOutput' name='rate'   type='SFInt32' value='15'/>  
        </IOSensor-->
  
        <!-- MarkerTracker IOSensor -->
        <IOSensor DEF='markerTracker' name='markerTracker' type='bart_iio' useInternalInput='true' internalWidth='1280' internalHeight='720' flipImage='false'
              configUrl='markerMatrixTest.yaml'>
            <field accessType='inputOnly'  name='cameraId'         type='SFString'/>
            <field accessType='inputOnly'  name='inputImage'        type='SFImage'/>  
            <field accessType='inputOnly'  name='frameNumber'       type='SFInt32'/>  
            <field accessType='outputOnly' name='markerMatrizes'    type='MFMatrix4f'/>
            <field accessType='outputOnly' name='globalCameraTransform' type='SFMatrix4f'/>
            <field accessType='outputOnly' name='markerIds'         type='MFInt32'/>
            <field accessType='outputOnly' name='outputImage'       type='SFImage'/>
            <field accessType='outputOnly' name='outputMarkerImage'       type='SFImage'/>
            <field accessType='outputOnly' name='fieldOfView'       type='SFFloat'/>
            <field accessType='outputOnly' name='markerFrameNumber' type='SFInt32'/>
        </IOSensor>
        <!--ROUTE fromNode='video' fromField='frames' toNode='markerTracker' toField='inputImage' /-->

        <Script DEF='setCamId'>
          <field accessType='outputOnly' name='cameraId' type='SFString'/>
          
          <![CDATA[javascript:

            //--------------------
            function initialize() 
            {
                cameraId = "default";
            }
            //--------------------
          
         ]]>
            
        </Script>
        <ROUTE fromNode='setCamId' fromField='cameraId' toNode='markerTracker' toField='cameraId' />


        <Viewspace>
            <ImageBackground>
                <PixelTexture DEF='backgroundTexture'/>
            </ImageBackground>
        </Viewspace>
        <ROUTE fromNode='markerTracker' fromField='outputMarkerImage' toNode='backgroundTexture' toField='image' />
    
        <MatrixTransform DEF='viewTransform' invert='false'>
            <Viewpoint DEF='view' position='0 0 0' />
        </MatrixTransform>
        <ROUTE fromNode='markerTracker' fromField='globalCameraTransform' toNode='viewTransform' toField='matrix' />
        <ROUTE fromNode='markerTracker' fromField='fieldOfView'    toNode='view'          toField='fieldOfView' />
        
        <Transform DEF='testBase'>
            <!--Shape DEF='markerShape'>
                <Box size='0.0565 0.0565 0.005'/>
                <Appearance>
                    <ImageTexture DEF="markerTexture" url='../textures/marker42.jpg'/>
                    <Material DEF='markerMaterial' diffuseColor='1 0 0' transparency='0.4'/>
                </Appearance>
            </Shape-->
            <!--Transform DEF='markerTransform' translation='0.005 -0.0285 0' >-->
            <Transform DEF='markerTransform' translation='0.09 0.14 0' >
                <Shape DEF='testShape'>
                    <Box size='0.18 0.28 0.005'/>
                    <Appearance>
                        <!--ImageTexture DEF="testTexture" url='../textures/marker42_transform.png'/-->
                        <Material DEF='testMaterial' diffuseColor='1 0 0' transparency='0.5'/>
                    </Appearance>
                </Shape>
            </Transform>
        </Transform>

    
    
  
    
    
    </Scene>
</X3D>

