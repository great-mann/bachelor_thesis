# ### Bielefeld AR Tracker INSTANTIO connection ###
# ===============================
# 
# Sets required variables for finding bart library:
#
# BART_INSTANTIO_FOUND
# BART_INSTANTIO_INCLUDE_DIRS
# BART_INSTANTIO_LIBRARY_DIRS
# BART_INSTANTIO_LIBRARIES
# BART_INSTANTIO_VERSION
# 
# Example:
# find_package(bart_iio 0.1)
#
# ###############################################################################

INCLUDE(FindPkgConfig)

GET_FILENAME_COMPONENT(CONFIG_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)

SET(BART_INSTANTIO_FOUND TRUE)
SET(BART_INSTANTIO_INCLUDE_DIRS "${CONFIG_DIR}/../../include/@BART_INSTANTIO_PACKAGE@")
SET(BART_INSTANTIO_VERSION "@BART_VERSION@")

# TODO: find dependencies here and append their include dirs to BART_INSTANTIO_INCLUDE_DIRS
